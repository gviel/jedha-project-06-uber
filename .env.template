# Copier ce fichier en .env et remplir les valeurs
# .env est gitignore — ne jamais commiter

# Clé du user IAM dédié `cdsd-uber` (get/put sur cdsd-uber-data/* uniquement), cf. docs/iam-aws.md.
# La même clé va dans .streamlit/secrets.toml et dans les Secrets de l'app Streamlit Cloud.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=eu-west-3

# Optionnel — valeur par défaut : cdsd-uber-data
S3_BUCKET=cdsd-uber-data
